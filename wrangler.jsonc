{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rise-performance-platform-site",
  "account_id": "3269cb5de40de43d088938ad89e7de19",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ATLAS_DLR_DELIVERY_TIMEZONE": "America/New_York",
    "ATLAS_DLR_SCHEDULE_WINDOW_MINUTES": "15",
    "ATLAS_DLR_EMAIL_PROVIDER": "cloudflare_email_service",
    "ATLAS_DLR_FROM_EMAIL": "central@risere.com",
    "ATLAS_APP_BASE_URL": "https://jac1827.github.io/ATLAS/portfolio-operations-dashboard/index.html"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * MON-FRI"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "central@risere.com"
      ],
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_STATE",
        "class_name": "PerformanceSyncState"
      },
      {
        "name": "EVICTION_CASES",
        "class_name": "EvictionCaseState"
      },
      {
        "name": "PROPERTY_SPECIALS",
        "class_name": "PropertySpecialsState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PerformanceSyncState"
      ]
    },
    {
      "tag": "v2-eviction-cases",
      "new_sqlite_classes": [
        "EvictionCaseState"
      ]
    },
    {
      "tag": "v3-property-specials",
      "new_sqlite_classes": [
        "PropertySpecialsState"
      ]
    }
  ],
  "assets": {
    "directory": "./output/atlas-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "node tools/build-atlas-site.mjs",
    "watch_dir": [
      "docs",
      "src",
      "tools/build-atlas-site.mjs",
      "tools/package-atlas-assets.mjs"
    ]
  }
}
